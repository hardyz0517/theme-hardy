{
  "name": "theme-hardy",
  "version": "0.1.0",
  "private": true,
  "description": "A clean, personal blog theme for Halo",
  "homepage": "https://github.com/hardyz0517/theme-hardy#readme",
  "bugs": {
    "url": "https://github.com/hardyz0517/theme-hardy/issues"
  },
  "author": "Hardy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardyz0517/theme-hardy.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && vp build && pnpm package",
    "build-only": "tsc && vp build",
    "dev": "vp build --watch",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:hardening": "node scripts/check-hardening.mjs",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "package": "node scripts/package-theme.mjs",
    "prepare": "vp config",
    "skills:update": "npx skills update"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.0.1",
    "@halo-dev/vite-plugin-halo-theme": "^1.0.3",
    "@types/node": "18.11.9",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.33.0"
}
